{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Houdini Partner API",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
        {
                "tab": "API reference (manual testing version)",
                "openapi": "openapi.json",
                "groups": [
                    {
                        "group": "Private Swaps",
                        "pages": [
                            "GET /tokens",
                            "GET /quotes",
                            "GET /quotes/byChainAddress",
                            "POST /exchanges",
                            "GET /orders",
                            "GET /orders/{houdiniId}"
                        ]
                    },
                    {
                        "group": "Standard Swaps",
                        "pages": [
                            "GET /tokens",
                            "GET /quotes",
                            "GET /quotes/byChainAddress",
                            "POST /exchanges",
                            "GET /orders",
                            "GET /orders/{houdiniId}"
                        ]
                    },
                    {
                        "group": "DEX Swaps",
                        "pages": [
                            "GET /tokens",
                            "GET /quotes",
                            "GET /quotes/byChainAddress",
                            "POST /exchanges",
                            "POST /dex/allowance",
                            "POST /dex/approve",
                            "POST /dex/chainSignatures",
                            "POST /dex/confirmTx",
                            "GET /orders",
                            "GET /orders/{houdiniId}"
                        ]
                    },
                    {
                        "group": "Multi-Exchange",
                        "pages": [
                            "GET /tokens",
                            "POST /quotes/multi",
                            "POST /exchanges/multi",
                            "GET /exchanges/multi/{multiId}",
                            {
                                "group": "Bundler",
                                "pages": [
                                    "POST /exchanges/multi/{multiId}/tx/build",
                                    "GET /exchanges/multi/{multiId}/tx",
                                    "POST /exchanges/multi/{multiId}/tx",
                                    "POST /exchanges/multi/{multiId}/retry",
                                    "POST /exchanges/multi/recovery"
                                ]
                            }
                        ]
                    },
                    {
                        "group": "Reference Data",
                        "pages": [
                            "GET /tokens/{id}",
                            "GET /chains",
                            "GET /swaps",
                            "GET /minMax"
                        ]
                    },
                    {
                        "group": "Partner Account",
                        "pages": [
                            "GET /me",
                            "GET /commissions",
                            "GET /commissions/summary",
                            "GET /withdrawals",
                            "GET /stats/volume",
                            "GET /stats/weeklyVolume",
                            "GET /stats/chart",
                            "GET /rateLimits"
                        ]
                    },
                    {
                        "group": "System",
                        "pages": ["GET /status"]
                    }
                ]
            }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Houdini Swap",
          "href": "https://houdiniswap.com",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
