{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Houdini Partner API",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "API reference (manual testing version)",
        "openapi": "openapi.json",
       "groups": [
                    {
                        "group": "Private and Standard Swaps",
                        "pages": [
                            "api-reference/private-and-standard-swaps/get-tokens",
                            "api-reference/private-and-standard-swaps/get-quotes",
                            "api-reference/private-and-standard-swaps/get-quotes-by-token-address",
                            "api-reference/private-and-standard-swaps/create-exchange",
                            "api-reference/private-and-standard-swaps/get-order-details"
                        ]
                    },
                    {
                        "group": "Private Send",
                        "pages": [
                            "api-reference/private-send/get-tokens",
                            "GET /quotes/private-send",
                            "POST /exchanges/private-send",
                            "api-reference/private-send/get-order-details"
                        ]
                    },
                    {
                        "group": "Multi-Exchange",
                        "pages": [
                            "api-reference/multi-exchange/get-tokens",
                            "POST /quotes/multi",
                            "POST /exchanges/multi",
                            "GET /exchanges/multi/{multiId}",
                            {
                                "group": "Bundler SOL",
                                "pages": [
                                    "api-reference/bundler-sol/get-batch-transaction"
                                ]
                            },
                            {
                                "group": "Bundler EVM",
                                "pages": [
                                    "api-reference/bundler-evm/build-batch-transaction",
                                    "POST /exchanges/multi/{multiId}/tx",
                                    "POST /exchanges/multi/{multiId}/retry",
                                    "POST /exchanges/multi/recovery"
                                ]
                            }
                        ]
                    },
                    {
                        "group": "On-chain DEX or Bridge",
                        "pages": [
                            "api-reference/on-chain-dex-or-bridge/get-tokens",
                            "api-reference/on-chain-dex-or-bridge/get-quotes",
                            "api-reference/on-chain-dex-or-bridge/get-quotes-by-token-address",
                            "api-reference/on-chain-dex-or-bridge/create-exchange",
                            "POST /dex/approve",
                            "POST /dex/allowance",
                            "POST /dex/chainSignatures",
                            "POST /dex/confirmTx",
                            "api-reference/on-chain-dex-or-bridge/get-order-details"
                        ]
                    },
                    {
                        "group": "Reference Data",
                        "pages": [
                            "GET /tokens/{id}",
                            "GET /chains",
                            "GET /swaps",
                            "GET /minMax"
                        ]
                    },
                    {
                        "group": "Partner Account",
                        "pages": [
                            "GET /orders",
                            "GET /me",
                            "GET /rateLimits",
                            "GET /commissions",
                            "GET /commissions/summary",
                            "GET /withdrawals",
                            "GET /stats/volume",
                            "GET /stats/weeklyVolume",
                            "GET /stats/chart"
                        ]
                    },
                    {
                        "group": "System",
                        "pages": [
                            "GET /status"
                        ]
                    }
                ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Houdini Swap",
          "href": "https://houdiniswap.com",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
