    { "source": "/api-reference/minmax/get-dex-and-cex-min-max-amounts", "destination": "/api-reference/reference-data/get-min-and-max-amounts" },
    { "source": "/api-reference/orders/get-all-active-orders", "destination": "/api-reference/partner-account/get-orders" },
    { "source": "/api-reference/orders/get-order-details", "destination": "/api-reference/private-and-standard-swaps/get-order-details" },
    { "source": "/api-reference/partner-profile/get-authenticated-partner-profile", "destination": "/api-reference/partner-account/get-partner-profile" },
