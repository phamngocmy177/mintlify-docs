    { "source": "/api-reference/stats/get-partner-volume-stats", "destination": "/api-reference/partner-account/get-volume-stats" },
    { "source": "/api-reference/stats/get-partner-weekly-volume-stats", "destination": "/api-reference/partner-account/get-weekly-volume" },
